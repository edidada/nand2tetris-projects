/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static Array ram;
    static int freeHead;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let freeHead = 2048;
        let ram[2048] = 14334;
        let ram[2049] = 0;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function Array alloc(int size) {
        var int current, previous, available, next, split;
        if (size < 1) { do Sys.error(5); }
        let current = freeHead;
        let previous = 0;
        while (~(current = 0)) {
            let available = ram[current];
            let next = ram[current + 1];
            if (~(available < size)) {
                if ((available - size) > 2) {
                    let split = current + size + 2;
                    let ram[split] = available - size - 2;
                    let ram[split + 1] = next;
                    let ram[current] = size;
                    let next = split;
                }
                if (previous = 0) { let freeHead = next; }
                else { let ram[previous + 1] = next; }
                let ram[current + 1] = 0;
                return current + 2;
            }
            let previous = current;
            let current = next;
        }
        do Sys.error(6);
        return 0;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int block, current, previous;
        let block = o - 2;
        let current = freeHead;
        let previous = 0;
        while ((~(current = 0)) & (current < block)) {
            let previous = current;
            let current = ram[current + 1];
        }
        let ram[block + 1] = current;
        if (previous = 0) { let freeHead = block; }
        else { let ram[previous + 1] = block; }
        if ((~(current = 0)) & ((block + ram[block] + 2) = current)) {
            let ram[block] = ram[block] + ram[current] + 2;
            let ram[block + 1] = ram[current + 1];
        }
        if ((~(previous = 0)) & ((previous + ram[previous] + 2) = block)) {
            let ram[previous] = ram[previous] + ram[block] + 2;
            let ram[previous + 1] = ram[block + 1];
        }
        return;
    }    
}
